[Unit]
Description=CaptureHost dashboard (backend + deploy pipeline)
Documentation=file:///opt/capturehost/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated, unprivileged system user. Deliberately NOT in the docker group:
# the only way to Docker is the socket proxy on 127.0.0.1:2375.
User=capturehost
Group=capturehost
WorkingDirectory=/opt/capturehost/backend
EnvironmentFile=/etc/capturehost/capturehost.env
ExecStart=/usr/bin/node /opt/capturehost/backend/dist/index.js
Restart=on-failure
RestartSec=5

# ---- sandboxing -----------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The only writable path: SQLite, cloned repos, build contexts and backups.
ReadWritePaths=/var/lib/capturehost
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# Network: TCP only, no raw sockets, no AF_NETLINK tricks.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#
# NOTE: there is deliberately no IPAddressAllow/IPAddressDeny egress filter.
# `IPAddressAllow=localhost` + `IPAddressDeny=any` looks attractive — the only
# services this app talks to are on loopback — but systemd applies the filter to
# the whole cgroup, so the `git clone` in a deployment would be dropped too and
# every deploy would time out. systemd's filter is address-based, not
# port-based, so "allowed: 443 out" cannot be expressed.
# Consequence: builds can reach the internet. That is the cost of the feature;
# it is why the README insists on deploying only trusted repositories.
# A laptop-sized ceiling; raise if you deploy large builds.
MemoryMax=2G
TasksMax=4096

# Logs go to the journal: journalctl -u capturehost -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
