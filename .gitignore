# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
*.tsbuildinfo

# environment & secrets  (NEVER commit)
.env
.env.local
.env.*.local
*.pem
*.key

# database (local runtime state)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/backups/

# brand source art (JPEG masters; the build uses WebP in src/assets)
brand-incoming/

# runtime artifacts
deployments/
logs/
*.log
# launcher state: pids, and the dev logs written by capturehost.py
.run/

# python
__pycache__/
*.pyc

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
