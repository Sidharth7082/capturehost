# ---- CaptureHost backend ----
# Never commit the real .env. Copy this file: cp .env.example .env

# Bind address. Keep 127.0.0.1 — remote access goes through Tailscale
# or a Cloudflare Tunnel, never an open public port.
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# SQLite file (created automatically, relative to backend/)
DB_PATH=./data/capturehost.db

# Origins allowed to open the metrics WebSocket.
# Comma separated. The browser always sends Origin on a WS handshake,
# so this is the real gate against cross-site socket hijacking.
# Dev default = the Vite dev server. Prod: your dashboard hostname.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- auth ----
# 32-byte key used to encrypt secrets at rest (TOTP secrets today, project env
# vars later) with AES-256-GCM. Generate one and keep it OUT of git:
#   openssl rand -base64 32
# Losing this key means stored TOTP secrets become unreadable; 2FA would have
# to be reset with `npm run reset:admin`.
APP_ENCRYPTION_KEY=

# Session lifetime. Idle slides forward while you use the dashboard; absolute is
# a hard cap that no amount of activity can extend.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# true only when the dashboard is served over HTTPS: the cookie then gets the
# Secure flag and the __Host- prefix.
SESSION_COOKIE_SECURE=false

# argon2id cost parameters (password hashing)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Login throttling: N failures inside the window locks BOTH the IP and the
# username, with the lockout doubling on repeat offenders.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# Leave false unless a trusted proxy (Caddy, Cloudflare Tunnel) terminates TLS
# in front of the backend. Turning it on without a proxy lets clients forge
# X-Forwarded-For and dodge the IP rate limit.
TRUST_PROXY=false

# ---- docker ----
# Always the socket proxy from docker-compose.dev.yml, never /var/run/docker.sock.
# The backend logs a warning if this looks like a socket path.
DOCKER_HOST_URL=http://127.0.0.1:2375
# Must be larger than the stop grace period (5s), otherwise a slow
# `docker stop` is misread as an unreachable proxy.
DOCKER_TIMEOUT_MS=30000
# How often the one shared poller asks for container CPU/RAM.
DOCKER_STATS_INTERVAL_MS=2500
# Extra containers the dashboard must never stop/remove (comma separated
# names or id prefixes). The socket proxy is also protected by its label.
DOCKER_PROTECTED_CONTAINERS=capturehost-socket-proxy
# Start/stop/restart/remove actions allowed per session per minute.
DOCKER_ACTIONS_PER_MINUTE=30

# Sampling + retention for metrics
METRICS_INTERVAL_MS=2000
METRICS_RETENTION_HOURS=24

# ---- deployments (Phase 4) ----
# Where repositories are cloned and built. Cleaned after every build; the
# parent must be writable by the backend user.
DEPLOY_DATA_DIR=./data/deployments
# Hard limit for one image build. The UI shows the same number.
DEPLOY_BUILD_TIMEOUT_MS=900000
# Images kept per project (capturehost/<slug>:<sha>), oldest removed first.
DEPLOY_KEEP_IMAGES=3
# Build log kept in SQLite per deployment; only the tail is retained.
DEPLOY_MAX_LOG_BYTES=524288
# Refuse to clone a repository larger than this.
DEPLOY_MAX_CLONE_BYTES=209715200
# Deploy/rollback/cancel actions allowed per session per minute.
DEPLOY_ACTIONS_PER_MINUTE=10
# Timeout for the git clone itself.
GIT_TIMEOUT_MS=120000

# ---- container safety policy ----
# Defaults applied to every container CaptureHost creates. A project may ask
# for less, never for more than the MAX values.
CONTAINER_MEMORY_MB_DEFAULT=512
CONTAINER_MEMORY_MB_MAX=4096
CONTAINER_CPU_DEFAULT=0.5
CONTAINER_CPU_MAX=4
CONTAINER_PIDS_LIMIT=256
# Host ports are only ever published on 127.0.0.1, inside this range.
CONTAINER_PORT_RANGE_START=8100
CONTAINER_PORT_RANGE_END=8999
# Created by docker-compose.dev.yml. Never created through the Docker API.
CONTAINER_NETWORK=capturehost-apps
# Blue/green health check: how long a new container gets to become healthy.
HEALTH_CHECK_TIMEOUT_MS=30000

# ---- github webhooks ----
# Largest accepted webhook body. Anything bigger is rejected before HMAC.
WEBHOOK_MAX_BODY_BYTES=1048576

# ---- caddy / domains (Phase 5) ----
# local  -> hostnames under *.localhost, plain HTTP on a loopback listener
# tunnel -> same listener; a Cloudflare Tunnel in front terminates HTTPS
# public -> direct 80/443 with automatic HTTPS (UNTESTED, off by default)
CADDY_MODE=local
# The admin API has no authentication: loopback only, and the backend refuses
# any other address at startup.
CADDY_ADMIN_URL=http://127.0.0.1:2019
# The only listener deployed sites are reachable on.
CADDY_APPS_LISTEN=127.0.0.1:8080
# Private dashboard listener (separate port, never the apps port).
CADDY_DASHBOARD_HOST=capturehost.localhost
CADDY_DASHBOARD_LISTEN=127.0.0.1:8090
# Re-apply the desired routes from SQLite this often (drift repair).
CADDY_SYNC_INTERVAL_MS=60000
CADDY_REQUEST_TIMEOUT_MS=5000
# Hostnames must end with one of these. The UI cannot change it.
ALLOWED_BASE_DOMAINS=localhost
# Optional public webhook gateway host (off unless set; see README).
# WEBHOOK_PUBLIC_HOST=hooks.example.com
# X-Forwarded-For is believed only from these addresses (the loopback proxy).
TRUST_PROXY_ADDRESSES=127.0.0.1,::1
