# ---- CaptureHost backend ----
# Never commit the real .env. Copy this file: cp .env.example .env

# Bind address. Keep 127.0.0.1 — remote access goes through Tailscale
# or a Cloudflare Tunnel, never an open public port.
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# SQLite file (created automatically, relative to backend/)
DB_PATH=./data/capturehost.db

# Origins allowed to open the metrics WebSocket.
# Comma separated. The browser always sends Origin on a WS handshake,
# so this is the real gate against cross-site socket hijacking.
# Dev default = the Vite dev server. Prod: your dashboard hostname.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- auth ----
# 32-byte key used to encrypt secrets at rest (TOTP secrets today, project env
# vars later) with AES-256-GCM. Generate one and keep it OUT of git:
#   openssl rand -base64 32
# Losing this key means stored TOTP secrets become unreadable; 2FA would have
# to be reset with `npm run reset:admin`.
APP_ENCRYPTION_KEY=

# Session lifetime. Idle slides forward while you use the dashboard; absolute is
# a hard cap that no amount of activity can extend.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# true only when the dashboard is served over HTTPS: the cookie then gets the
# Secure flag and the __Host- prefix.
SESSION_COOKIE_SECURE=false

# argon2id cost parameters (password hashing)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Login throttling: N failures inside the window locks BOTH the IP and the
# username, with the lockout doubling on repeat offenders.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# Leave false unless a trusted proxy (Caddy, Cloudflare Tunnel) terminates TLS
# in front of the backend. Turning it on without a proxy lets clients forge
# X-Forwarded-For and dodge the IP rate limit.
TRUST_PROXY=false

# ---- docker ----
# Always the socket proxy from docker-compose.dev.yml, never /var/run/docker.sock.
# The backend logs a warning if this looks like a socket path.
DOCKER_HOST_URL=http://127.0.0.1:2375
# Must be larger than the stop grace period (5s), otherwise a slow
# `docker stop` is misread as an unreachable proxy.
DOCKER_TIMEOUT_MS=30000
# How often the one shared poller asks for container CPU/RAM.
DOCKER_STATS_INTERVAL_MS=2500
# Extra containers the dashboard must never stop/remove (comma separated
# names or id prefixes). The socket proxy is also protected by its label.
DOCKER_PROTECTED_CONTAINERS=capturehost-socket-proxy
# Start/stop/restart/remove actions allowed per session per minute.
DOCKER_ACTIONS_PER_MINUTE=30

# Sampling + retention for metrics
METRICS_INTERVAL_MS=2000
METRICS_RETENTION_HOURS=24
