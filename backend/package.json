{
  "name": "capturehost-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "setup:admin": "tsx src/scripts/setup-admin.ts",
    "reset:admin": "tsx src/scripts/reset-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/websocket": "11.3.7",
    "argon2": "0.45.2",
    "better-sqlite3": "13.0.3",
    "dockerode": "5.0.1",
    "fastify": "5.12.8",
    "otplib": "13.6.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "systeminformation": "5.33.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/dockerode": "4.0.2",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
